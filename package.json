{
  "name": "jurispetrus",
  "version": "0.3.1",
  "description": "Servidor MCP de jurisprudência e legislação brasileira para Claude, com fontes oficiais verificáveis",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc",
    "empacotar:mac": "scripts/empacotar-mac.sh",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/http.ts",
    "ingest": "node dist/ingest/cli.js",
    "ingest:dev": "tsx src/ingest/cli.ts",
    "vetorizar": "node dist/ingest/vetorizar-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "modelo": "scripts/baixar-modelo.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpsmatosadv/jurispetrus.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/jpsmatosadv/jurispetrus/issues"
  },
  "homepage": "https://github.com/jpsmatosadv/jurispetrus#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "onnxruntime-node": "^1.30.0",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
