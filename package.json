{
  "name": "jurispetrus",
  "version": "0.1.0",
  "description": "Servidor MCP de jurisprudência e legislação brasileira para Claude, com fontes oficiais verificáveis",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/http.ts",
    "ingest": "node dist/ingest/cli.js",
    "ingest:dev": "tsx src/ingest/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpsmatosadv/jurispetrus.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/jpsmatosadv/jurispetrus/issues"
  },
  "homepage": "https://github.com/jpsmatosadv/jurispetrus#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
