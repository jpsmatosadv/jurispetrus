# Caminho do banco SQLite com o acervo
JURIS_DB_PATH=data/acervo.db
PORT=3000
HOST=0.0.0.0
# Hosts aceitos (ex.: juris.seudominio.com.br). Vazio = qualquer.
JURIS_ALLOWED_HOSTS=
# Chaves de acesso separadas por vírgula. Vazio = servidor aberto (use só localmente).
JURIS_API_KEYS=
# Chamadas de ferramenta por chave por mês (0 = ilimitado)
JURIS_COTA_MENSAL=0
# Opcional: chave própria do DataJud (por padrão usa a chave pública do CNJ)
DATAJUD_API_KEY=
# Busca semântica: voyage | openai | nenhum
JURIS_EMBEDDINGS=nenhum
JURIS_EMBEDDINGS_MODEL=
JURIS_EMBEDDINGS_DIM=
JURIS_EMBEDDINGS_URL=
VOYAGE_API_KEY=
JURIS_EMBEDDINGS_KEY=
# Tempo-limite (ms) de cada portal consultado ao vivo
JURIS_TIMEOUT_FONTES=25000
